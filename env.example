# ===== Crypto_Calendar — environment template =====
# Copy to .env (gitignored) and fill in. Frontend reads VITE_* at build time.

# ⚠️ ДВІ РІЗНІ БАЗИ. Не переплутати — це вже коштувало налагодження:
#   CALENDAR (bnidayqhxpievwcnugnl) — ЯДРО сайту: events_*, admins, exchanges,
#            event_types, reactions, telegram_*, site_creator_campaigns.
#   ROMA     (jtskeszumqapfjhpyevq) — ЛИШЕ сторінки /live і /claims:
#            okx_campaigns, okx_volume, tournaments*, fee_tiers, claim_*.
# Прод на Vercel використовує саме CALENDAR у VITE_SUPABASE_URL / SUPABASE_URL.

# ---- Supabase CALENDAR (frontend, public — protected by RLS) ----
VITE_SUPABASE_URL=https://bnidayqhxpievwcnugnl.supabase.co
VITE_SUPABASE_ANON_KEY=__calendar_anon_key_here__     # Supabase → Project Settings → API → anon

# ---- Supabase ROMA (сторінки /live і /claims) ----
# Опційно: без цих змінних береться вшитий фолбек у коді.
# VITE_ROMA_SUPABASE_URL=https://jtskeszumqapfjhpyevq.supabase.co
# VITE_ROMA_SUPABASE_ANON_KEY=sb_publishable_...

# ---- Server-side (Vercel functions) — KEEP SECRET, never commit real values ----
# Та сама CALENDAR-база, але сервісним ключем.
SUPABASE_URL=https://bnidayqhxpievwcnugnl.supabase.co
SUPABASE_SERVICE_ROLE_KEY=__service_role_key_here__   # Supabase → Project Settings → API → service_role

# ---- Claim watcher Telegram alerts (optional; falls back to the admin bot below) ----
# CLAIM_TG_BOT_TOKEN=
# CLAIM_TG_CHAT_ID=

# ---- Existing app integrations (only needed for the rest of the calendar) ----
# TELEGRAM_ADMIN_BOT_TOKEN=
# ADMIN_TG_CHAT_ID=
# SITE_URL=https://cryptoeventscalendar.com
# BINANCE_SYNC_SECRET=
